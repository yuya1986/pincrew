# 地図スタイル（任意）
# 未設定のときは OpenFreeMap の明るいスタイルを使います。
# MapTiler などを使う場合は、キーをソースコードへ直書きせず、ここに置いてください。
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Supabase（Vercel 連携で入ります。値は .env.local に置き、ここには書きません）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
